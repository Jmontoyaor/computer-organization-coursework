{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar Mario (ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/mario.elf",
      "device": "STM32L476RG",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Compilar",
      "serverpath": "${env:HOME}/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.stlink-gdb-server.linux64_2.2.500.202604010938/tools/bin/ST-LINK_gdbserver",
      "stm32cubeprogrammer": "${env:HOME}/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.cubeprogrammer.linux64_2.2.500.202603051304/tools/bin",
      "armToolchainPath": "${env:HOME}/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.linux64_1.0.100.202602081740/tools/bin",
      "serverArgs": ["-k"],
      "gdbPath": "${env:HOME}/st/stm32cubeide_2.2.0/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.linux64_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb"
    }
  ]
}
